# ------------------------------------------------------------------
# UXLens AI — environment variables (copy to `.env` and fill in)
# ------------------------------------------------------------------

# Port the Express backend listens on
PORT=3001

# Gemini API key (server-side only, never exposed to the client)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use for analysis
GEMINI_MODEL=gemini-3.5-flash-lite

# When "true", /api/analyze returns a realistic mock report instead of
# hitting Gemini + Puppeteer. Great for demoing without a key.
USE_MOCK=false

# Max time (ms) Puppeteer waits for a page to load before giving up
SCREENSHOT_TIMEOUT_MS=25000

# Optional: path to a Chrome/Edge executable. UXLens auto-detects common
# install locations, so you usually won't need this.
# BROWSER_PATH=C:\Program Files (x86)\Google\Chrome\Application\chrome.exe
